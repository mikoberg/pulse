# Copy to .env and fill in. Every value here exists because one of the
# four signals needs it — there is nothing optional to configure beyond this.

PULSE_CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/.../basic.ics
PULSE_CALENDAR_TRAVEL_MINUTES=20

PULSE_GITHUB_OWNER=your-username
PULSE_GITHUB_REPO=your-repo
PULSE_GITHUB_BRANCH=main

PULSE_WEATHER_LAT=52.37
PULSE_WEATHER_LON=4.90

PULSE_LAUNCH_ICS_URL=https://mikoberg.github.io/techics/calendar.ics
